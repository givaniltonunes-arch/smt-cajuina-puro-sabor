function Produtos() {
  const produtos = [
    {
      nome: "Cajuína Puro Sabor",
      descricao: "Cajuína de qualidade, produzida com sabor e tradição.",
    },
    {
      nome: "Cajuína Tradicional",
      descricao: "O sabor tradicional da cajuína do Piauí.",
    },
    {
      nome: "Cajuína Premium",
      descricao: "Qualidade e sabor em uma experiência especial.",
    },
  ];

  return (
    <main>
      <section className="produtos-intro">
        <h1>Nossos Produtos</h1>
        <p>Conheça os produtos da SMT Cajuína Puro Sabor.</p>
      </section>

